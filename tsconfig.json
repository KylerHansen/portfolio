{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false
  },
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "./packages/app/frontend/tsconfig.json" },
    { "path": "./packages/app/backend/tsconfig.json" },
    { "path": "./packages/common/universal/tsconfig.json" }
  ]
}
