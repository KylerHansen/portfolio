{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "outDir": "./dist/",
    "rootDir": "./src/"
  },
  "exclude": ["./dist/", "node_modules"],
  "include": ["src"]
}
